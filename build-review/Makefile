# Build rule for target.
SparqlProtocolTest: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 SparqlProtocolTest
.PHONY : SparqlProtocolTest

# fast build rule for target.
SparqlProtocolTest/fast:
	$(MAKE) $(MAKESILENT) -f test/CMakeFiles/SparqlProtocolTest.dir/build.make test/CMakeFiles/SparqlProtocolTest.dir/build
.PHONY : SparqlProtocolTest/fast

