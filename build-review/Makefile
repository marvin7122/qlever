SynchronizedTest: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 SynchronizedTest
.PHONY : SynchronizedTest

# fast build rule for target.
SynchronizedTest/fast:
	$(MAKE) $(MAKESILENT) -f test/CMakeFiles/SynchronizedTest.dir/build.make test/CMakeFiles/SynchronizedTest.dir/build
.PHONY : SynchronizedTest/fast

